{
  "openapi": "3.1.0",
  "info": {
    "title": "Pinecone selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.pinecone.io"
    }
  ],
  "paths": {
    "/indexes": {
      "get": {
        "operationId": "list_indexes",
        "summary": "List indexes visible to the key’s project using the pinned control-plane API version.",
        "parameters": [
          {
            "name": "X-Pinecone-Api-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2025-10",
              "default": "2025-10"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/indexes/{index_name}": {
      "get": {
        "operationId": "describe_index",
        "summary": "Inspect index host, dimension and readiness metadata before configuring a separate data-plane client.",
        "parameters": [
          {
            "name": "index_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 45,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          {
            "name": "X-Pinecone-Api-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2025-10",
              "default": "2025-10"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Api-Key"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
