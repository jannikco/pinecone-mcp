  "description": "Inspect control-plane indexes and deployment status. This connector does not create infrastructure or query an index-specific data-plane host.",
  "tools": [
    {
      "name": "list_indexes",
      "description": "List indexes visible to the key’s project using the pinned control-plane API version.",
      "method": "GET",
      "path": "/indexes",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {}
      },
      "sampleArguments": {},
