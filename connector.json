        "https://docs.pinecone.io/reference/api/2025-10/control-plane/describe_index"
      ]
    },
    {
      "name": "describe_index",
      "description": "Inspect index host, dimension and readiness metadata before configuring a separate data-plane client.",
      "method": "GET",
      "path": "/indexes/{index_name}",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "index_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": [
          "index_name"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "index_name"
        ],
        "query": {},
        "body": {}
      },
      "sampleArguments": {
        "index_name": "documents"
      },
